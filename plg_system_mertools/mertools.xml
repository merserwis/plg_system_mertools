<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>plg_system_mertools</name>
    <author>Merserwis</author>
    <authorUrl>https://github.com/merserwis/</authorUrl>
    <creationDate>2026-10-07</creationDate>
    <copyright>Copyright (C) 2026 Merserwis. All rights reserved.</copyright>
    <license>GNU General Public License version 3</license>
    <version>0.0.21</version>
    <description>PLG_SYSTEM_MERTOOLS_XML_DESCRIPTION</description>
    <namespace path="src">Merserwis\Plugin\System\MerTools</namespace>
    <files>
        <folder plugin="mertools">services</folder>
        <folder>src</folder>
        <folder>language</folder>
        <filename>script.php</filename>
    </files>
    <media folder="media" destination="plg_system_mertools">
        <folder>js</folder>
    </media>
    <scriptfile>script.php</scriptfile>
    <languages folder="language">
        <language tag="en-GB">en-GB/plg_system_mertools.ini</language>
        <language tag="en-GB">en-GB/plg_system_mertools.sys.ini</language>
        <language tag="pl-PL">pl-PL/plg_system_mertools.ini</language>
        <language tag="pl-PL">pl-PL/plg_system_mertools.sys.ini</language>
    </languages>
    <config>
        <fields name="params" addfieldprefix="Merserwis\Plugin\System\MerTools\Field">
            <fieldset name="basic">
                <field name="intro_note" type="note" class="alert alert-info" label="PLG_SYSTEM_MERTOOLS_INTRO_LABEL" description="PLG_SYSTEM_MERTOOLS_INTRO_DESC" />
            </fieldset>

            <!-- ============================================================ Canonical URL -->
            <fieldset name="url" label="PLG_SYSTEM_MERTOOLS_FIELDSET_URL">
                <field name="url_note" type="note" class="alert alert-info" description="PLG_SYSTEM_MERTOOLS_URL_NOTE" />
                <field name="url_collapse_slashes" type="radio" layout="joomla.form.field.radio.switcher" default="1"
                    label="PLG_SYSTEM_MERTOOLS_URL_COLLAPSE_LABEL" description="PLG_SYSTEM_MERTOOLS_URL_COLLAPSE_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="url_redirect_code" type="list" default="301" showon="url_collapse_slashes:1"
                    label="PLG_SYSTEM_MERTOOLS_URL_CODE_LABEL" description="PLG_SYSTEM_MERTOOLS_URL_CODE_DESC">
                    <option value="301">PLG_SYSTEM_MERTOOLS_URL_CODE_301</option>
                    <option value="302">PLG_SYSTEM_MERTOOLS_URL_CODE_302</option>
                </field>
                <field name="url_cf_note" type="note" class="alert alert-warning" description="PLG_SYSTEM_MERTOOLS_URL_CF_NOTE" />
            </fieldset>

            <!-- ============================================================ Page speed -->
            <fieldset name="speed" label="PLG_SYSTEM_MERTOOLS_FIELDSET_SPEED">
                <field name="speed_key" type="password" default="" filter="string" autocomplete="off"
                    label="PLG_SYSTEM_MERTOOLS_SPEED_KEY_LABEL" description="PLG_SYSTEM_MERTOOLS_SPEED_KEY_DESC" />
                <field name="speed_urls" type="textarea" default="/" rows="4" filter="string"
                    label="PLG_SYSTEM_MERTOOLS_SPEED_URLS_LABEL" description="PLG_SYSTEM_MERTOOLS_SPEED_URLS_DESC" />
                <field name="speed_runs" type="list" default="3"
                    label="PLG_SYSTEM_MERTOOLS_SPEED_RUNS_LABEL" description="PLG_SYSTEM_MERTOOLS_SPEED_RUNS_DESC">
                    <option value="1">1</option>
                    <option value="3">3</option>
                    <option value="5">5</option>
                </field>
                <field name="speed_tools_note" type="note" class="alert alert-info" label="PLG_SYSTEM_MERTOOLS_SPEED_TOOLS_NOTE_LABEL"
                    description="PLG_SYSTEM_MERTOOLS_SPEED_TOOLS_NOTE_DESC" />
                <field name="speed_images" type="radio" layout="joomla.form.field.radio.switcher" default="1"
                    label="PLG_SYSTEM_MERTOOLS_SPEED_IMAGES_LABEL" description="PLG_SYSTEM_MERTOOLS_SPEED_IMAGES_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="speed_mainphoto" type="radio" layout="joomla.form.field.radio.switcher" default="1"
                    label="PLG_SYSTEM_MERTOOLS_SPEED_MAINPHOTO_LABEL" description="PLG_SYSTEM_MERTOOLS_SPEED_MAINPHOTO_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="speed_video" type="radio" layout="joomla.form.field.radio.switcher" default="1"
                    label="PLG_SYSTEM_MERTOOLS_SPEED_VIDEO_LABEL" description="PLG_SYSTEM_MERTOOLS_SPEED_VIDEO_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="speed_video_delay" type="number" default="3" min="0" max="60" filter="integer" showon="speed_video:1"
                    label="PLG_SYSTEM_MERTOOLS_SPEED_VIDEO_DELAY_LABEL" description="PLG_SYSTEM_MERTOOLS_SPEED_VIDEO_DELAY_DESC" />
                <field name="speed_scripts" type="radio" layout="joomla.form.field.radio.switcher" default="0"
                    label="PLG_SYSTEM_MERTOOLS_SPEED_SCRIPTS_LABEL" description="PLG_SYSTEM_MERTOOLS_SPEED_SCRIPTS_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="speed_scripts_list" type="textarea" rows="6" filter="raw" showon="speed_scripts:1"
                    default="googletagmanager.com&#10;fbq(&#10;connect.facebook.net&#10;clarity.ms&#10;hotjar.com&#10;elfsightcdn.com&#10;cloudflareinsights.com"
                    label="PLG_SYSTEM_MERTOOLS_SPEED_SCRIPTS_LIST_LABEL" description="PLG_SYSTEM_MERTOOLS_SPEED_SCRIPTS_LIST_DESC" />
                <field name="speed_scripts_keep" type="textarea" rows="2" filter="raw" showon="speed_scripts:1"
                    default="cookieconsent&#10;cookie-consent"
                    label="PLG_SYSTEM_MERTOOLS_SPEED_SCRIPTS_KEEP_LABEL" description="PLG_SYSTEM_MERTOOLS_SPEED_SCRIPTS_KEEP_DESC" />
                <field name="speed_scripts_timeout" type="number" default="0" min="0" max="120" filter="integer" showon="speed_scripts:1"
                    label="PLG_SYSTEM_MERTOOLS_SPEED_SCRIPTS_TIMEOUT_LABEL" description="PLG_SYSTEM_MERTOOLS_SPEED_SCRIPTS_TIMEOUT_DESC" />
                <field name="speed_panel" type="mtspeed" hiddenLabel="true"
                    label="PLG_SYSTEM_MERTOOLS_SPEED_PANEL_LABEL" />
            </fieldset>

            <!-- ============================================================ Page not found (404) -->
            <fieldset name="notfound" label="PLG_SYSTEM_MERTOOLS_FIELDSET_NOTFOUND">
                <field name="notfound_redirect" type="radio" layout="joomla.form.field.radio.switcher" default="1"
                    label="PLG_SYSTEM_MERTOOLS_NOTFOUND_REDIRECT_LABEL" description="PLG_SYSTEM_MERTOOLS_NOTFOUND_REDIRECT_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="notfound_target" type="list" default="home" showon="notfound_redirect:1"
                    label="PLG_SYSTEM_MERTOOLS_NOTFOUND_TARGET_LABEL" description="PLG_SYSTEM_MERTOOLS_NOTFOUND_TARGET_DESC">
                    <option value="home">PLG_SYSTEM_MERTOOLS_NOTFOUND_TARGET_HOME</option>
                    <option value="menu">PLG_SYSTEM_MERTOOLS_NOTFOUND_TARGET_MENU</option>
                    <option value="url">PLG_SYSTEM_MERTOOLS_NOTFOUND_TARGET_URL</option>
                </field>
                <field name="notfound_menuitem" type="menuitem" default="" showon="notfound_redirect:1[AND]notfound_target:menu"
                    label="PLG_SYSTEM_MERTOOLS_NOTFOUND_MENUITEM_LABEL" description="PLG_SYSTEM_MERTOOLS_NOTFOUND_MENUITEM_DESC">
                    <option value="">JSELECT</option>
                </field>
                <field name="notfound_url" type="text" default="" filter="string" showon="notfound_redirect:1[AND]notfound_target:url"
                    hint="/kontakt"
                    label="PLG_SYSTEM_MERTOOLS_NOTFOUND_URL_LABEL" description="PLG_SYSTEM_MERTOOLS_NOTFOUND_URL_DESC" />
                <field name="notfound_code" type="list" default="301" showon="notfound_redirect:1"
                    label="PLG_SYSTEM_MERTOOLS_NOTFOUND_CODE_LABEL" description="PLG_SYSTEM_MERTOOLS_NOTFOUND_CODE_DESC">
                    <option value="301">PLG_SYSTEM_MERTOOLS_NOTFOUND_CODE_301</option>
                    <option value="302">PLG_SYSTEM_MERTOOLS_NOTFOUND_CODE_302</option>
                </field>
                <field name="notfound_exclude" type="textarea" default="" rows="3" filter="string" showon="notfound_redirect:1"
                    hint="/api/"
                    label="PLG_SYSTEM_MERTOOLS_NOTFOUND_EXCLUDE_LABEL" description="PLG_SYSTEM_MERTOOLS_NOTFOUND_EXCLUDE_DESC" />
            </fieldset>

            <!-- ============================================================ Page layout -->
            <fieldset name="layout" label="PLG_SYSTEM_MERTOOLS_FIELDSET_LAYOUT">
                <field name="layout_clip_x" type="radio" layout="joomla.form.field.radio.switcher" default="1"
                    label="PLG_SYSTEM_MERTOOLS_LAYOUT_CLIP_LABEL" description="PLG_SYSTEM_MERTOOLS_LAYOUT_CLIP_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>

            <!-- ============================================================ Shop -->
            <fieldset name="shop" label="PLG_SYSTEM_MERTOOLS_FIELDSET_SHOP">
                <field name="shop_option_links" type="radio" layout="joomla.form.field.radio.switcher" default="1"
                    label="PLG_SYSTEM_MERTOOLS_SHOP_OPTION_LINKS_LABEL" description="PLG_SYSTEM_MERTOOLS_SHOP_OPTION_LINKS_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="cart_spacer" type="spacer" hr="true" />
                <field name="cart_enabled" type="radio" layout="joomla.form.field.radio.switcher" default="1"
                    label="PLG_SYSTEM_MERTOOLS_CART_ENABLED_LABEL" description="PLG_SYSTEM_MERTOOLS_CART_ENABLED_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="cart_mode" type="list" default="manual" showon="cart_enabled:1"
                    label="PLG_SYSTEM_MERTOOLS_CART_MODE_LABEL" description="PLG_SYSTEM_MERTOOLS_CART_MODE_DESC">
                    <option value="manual">PLG_SYSTEM_MERTOOLS_CART_MODE_MANUAL</option>
                    <option value="daily">PLG_SYSTEM_MERTOOLS_CART_MODE_DAILY</option>
                    <option value="limit">PLG_SYSTEM_MERTOOLS_CART_MODE_LIMIT</option>
                </field>
                <field name="cart_limit" type="number" default="50000" min="100" step="1000" filter="integer"
                    showon="cart_enabled:1[AND]cart_mode:limit"
                    label="PLG_SYSTEM_MERTOOLS_CART_LIMIT_LABEL" description="PLG_SYSTEM_MERTOOLS_CART_LIMIT_DESC" />
                <field name="cart_days" type="number" default="30" min="8" max="3650" filter="integer" showon="cart_enabled:1"
                    label="PLG_SYSTEM_MERTOOLS_CART_DAYS_LABEL" description="PLG_SYSTEM_MERTOOLS_CART_DAYS_DESC" />
                <field name="cart_empty" type="radio" layout="joomla.form.field.radio.switcher" default="1" showon="cart_enabled:1"
                    label="PLG_SYSTEM_MERTOOLS_CART_EMPTY_LABEL" description="PLG_SYSTEM_MERTOOLS_CART_EMPTY_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="cart_panel" type="mtcarts" showon="cart_enabled:1"
                    label="PLG_SYSTEM_MERTOOLS_CART_PANEL_LABEL" description="PLG_SYSTEM_MERTOOLS_CART_PANEL_DESC" />
            </fieldset>

            <!-- ============================================================ Phone numbers -->
            <fieldset name="tel" label="PLG_SYSTEM_MERTOOLS_FIELDSET_TEL">
                <field name="tel_enabled" type="radio" layout="joomla.form.field.radio.switcher" default="1"
                    label="PLG_SYSTEM_MERTOOLS_TEL_ENABLED_LABEL" description="PLG_SYSTEM_MERTOOLS_TEL_ENABLED_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="tel_devices" type="list" default="all" showon="tel_enabled:1"
                    label="PLG_SYSTEM_MERTOOLS_TEL_DEVICES_LABEL" description="PLG_SYSTEM_MERTOOLS_TEL_DEVICES_DESC">
                    <option value="all">PLG_SYSTEM_MERTOOLS_TEL_DEVICES_ALL</option>
                    <option value="touch">PLG_SYSTEM_MERTOOLS_TEL_DEVICES_TOUCH</option>
                </field>
                <field name="tel_style" type="list" default="text" showon="tel_enabled:1"
                    label="PLG_SYSTEM_MERTOOLS_TEL_STYLE_LABEL" description="PLG_SYSTEM_MERTOOLS_TEL_STYLE_DESC">
                    <option value="text">PLG_SYSTEM_MERTOOLS_TEL_STYLE_TEXT</option>
                    <option value="link">PLG_SYSTEM_MERTOOLS_TEL_STYLE_LINK</option>
                </field>
                <field name="tel_country" type="text" default="48" showon="tel_enabled:1" filter="string" maxlength="4"
                    label="PLG_SYSTEM_MERTOOLS_TEL_COUNTRY_LABEL" description="PLG_SYSTEM_MERTOOLS_TEL_COUNTRY_DESC" />
                <field name="tel_exclude" type="text" default="" showon="tel_enabled:1"
                    label="PLG_SYSTEM_MERTOOLS_TEL_EXCLUDE_LABEL" description="PLG_SYSTEM_MERTOOLS_TEL_EXCLUDE_DESC" />
            </fieldset>

            <!-- ============================================================ Dark mode -->
            <fieldset name="dark" label="PLG_SYSTEM_MERTOOLS_FIELDSET_DARK">
                <field name="dark_note" type="note" class="alert alert-info" description="PLG_SYSTEM_MERTOOLS_DARK_NOTE" />
                <field name="dark_enabled" type="radio" layout="joomla.form.field.radio.switcher" default="0"
                    label="PLG_SYSTEM_MERTOOLS_DARK_ENABLED_LABEL" description="PLG_SYSTEM_MERTOOLS_DARK_ENABLED_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="dark_palette" type="list" default="slate" showon="dark_enabled:1"
                    label="PLG_SYSTEM_MERTOOLS_DARK_PALETTE_LABEL" description="PLG_SYSTEM_MERTOOLS_DARK_PALETTE_DESC">
                    <option value="slate">PLG_SYSTEM_MERTOOLS_DARK_PAL_SLATE</option>
                    <option value="charcoal">PLG_SYSTEM_MERTOOLS_DARK_PAL_CHARCOAL</option>
                    <option value="midnight">PLG_SYSTEM_MERTOOLS_DARK_PAL_MIDNIGHT</option>
                    <option value="warm">PLG_SYSTEM_MERTOOLS_DARK_PAL_WARM</option>
                    <option value="sepia">PLG_SYSTEM_MERTOOLS_DARK_PAL_SEPIA</option>
                    <option value="dim">PLG_SYSTEM_MERTOOLS_DARK_PAL_DIM</option>
                    <option value="custom">PLG_SYSTEM_MERTOOLS_DARK_PAL_CUSTOM</option>
                </field>
                <field name="dark_picker" type="radio" layout="joomla.form.field.radio.switcher" default="1" showon="dark_enabled:1[AND]dark_toggle:1"
                    label="PLG_SYSTEM_MERTOOLS_DARK_PICKER_LABEL" description="PLG_SYSTEM_MERTOOLS_DARK_PICKER_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="dark_palettes" type="checkboxes" default="slate,midnight,warm,sepia,charcoal" showon="dark_enabled:1[AND]dark_toggle:1[AND]dark_picker:1"
                    label="PLG_SYSTEM_MERTOOLS_DARK_PALETTES_LABEL" description="PLG_SYSTEM_MERTOOLS_DARK_PALETTES_DESC">
                    <option value="slate">PLG_SYSTEM_MERTOOLS_DARK_PALNAME_SLATE</option>
                    <option value="charcoal">PLG_SYSTEM_MERTOOLS_DARK_PALNAME_CHARCOAL</option>
                    <option value="midnight">PLG_SYSTEM_MERTOOLS_DARK_PALNAME_MIDNIGHT</option>
                    <option value="warm">PLG_SYSTEM_MERTOOLS_DARK_PALNAME_WARM</option>
                    <option value="sepia">PLG_SYSTEM_MERTOOLS_DARK_PALNAME_SEPIA</option>
                    <option value="dim">PLG_SYSTEM_MERTOOLS_DARK_PALNAME_DIM</option>
                    <option value="custom">PLG_SYSTEM_MERTOOLS_DARK_PALNAME_CUSTOM</option>
                </field>
                <field name="dark_intensity" type="range" default="50" min="0" max="100" step="1" showon="dark_enabled:1"
                    label="PLG_SYSTEM_MERTOOLS_DARK_INTENSITY_LABEL" description="PLG_SYSTEM_MERTOOLS_DARK_INTENSITY_DESC" />
                <field name="dark_preview" type="mtpreview" showon="dark_enabled:1" hiddenLabel="true"
                    label="PLG_SYSTEM_MERTOOLS_DARK_PREVIEW_LABEL" />
                <field name="dark_default" type="list" default="auto" showon="dark_enabled:1"
                    label="PLG_SYSTEM_MERTOOLS_DARK_DEFAULT_LABEL" description="PLG_SYSTEM_MERTOOLS_DARK_DEFAULT_DESC">
                    <option value="auto">PLG_SYSTEM_MERTOOLS_DARK_DEFAULT_AUTO</option>
                    <option value="light">PLG_SYSTEM_MERTOOLS_DARK_DEFAULT_LIGHT</option>
                    <option value="dark">PLG_SYSTEM_MERTOOLS_DARK_DEFAULT_DARK</option>
                </field>

                <field name="dark_accent_site" type="radio" layout="joomla.form.field.radio.switcher" default="1" showon="dark_enabled:1"
                    label="PLG_SYSTEM_MERTOOLS_DARK_ACCENT_SITE_LABEL" description="PLG_SYSTEM_MERTOOLS_DARK_ACCENT_SITE_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="dark_accent" type="color" default="#34dca2" showon="dark_enabled:1[AND]dark_accent_site:0"
                    label="PLG_SYSTEM_MERTOOLS_DARK_ACCENT_LABEL" description="PLG_SYSTEM_MERTOOLS_DARK_ACCENT_DESC" />

                <field name="dark_toggle" type="radio" layout="joomla.form.field.radio.switcher" default="1" showon="dark_enabled:1"
                    label="PLG_SYSTEM_MERTOOLS_DARK_TOGGLE_LABEL" description="PLG_SYSTEM_MERTOOLS_DARK_TOGGLE_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="dark_toggle_place" type="list" default="auto" showon="dark_enabled:1[AND]dark_toggle:1"
                    label="PLG_SYSTEM_MERTOOLS_DARK_PLACE_LABEL" description="PLG_SYSTEM_MERTOOLS_DARK_PLACE_DESC">
                    <option value="auto">PLG_SYSTEM_MERTOOLS_DARK_PLACE_AUTO</option>
                    <option value="start">PLG_SYSTEM_MERTOOLS_DARK_PLACE_START</option>
                    <option value="end">PLG_SYSTEM_MERTOOLS_DARK_PLACE_END</option>
                    <option value="float">PLG_SYSTEM_MERTOOLS_DARK_PLACE_FLOAT</option>
                    <option value="float-left">PLG_SYSTEM_MERTOOLS_DARK_PLACE_FLOAT_LEFT</option>
                    <option value="float-a11y-above">PLG_SYSTEM_MERTOOLS_DARK_PLACE_A11Y_ABOVE</option>
                    <option value="float-a11y-beside">PLG_SYSTEM_MERTOOLS_DARK_PLACE_A11Y_BESIDE</option>
                </field>
                <field name="dark_float_x" type="number" default="18" min="0" max="400" step="1" filter="integer"
                    showon="dark_enabled:1[AND]dark_toggle:1[AND]dark_toggle_place:float,float-left"
                    label="PLG_SYSTEM_MERTOOLS_DARK_FLOAT_X_LABEL" description="PLG_SYSTEM_MERTOOLS_DARK_FLOAT_X_DESC" />
                <field name="dark_float_y" type="number" default="18" min="0" max="400" step="1" filter="integer"
                    showon="dark_enabled:1[AND]dark_toggle:1[AND]dark_toggle_place:float,float-left"
                    label="PLG_SYSTEM_MERTOOLS_DARK_FLOAT_Y_LABEL" description="PLG_SYSTEM_MERTOOLS_DARK_FLOAT_Y_DESC" />
                <field name="dark_a11y_selector" type="text" default="._access-icon"
                    showon="dark_enabled:1[AND]dark_toggle:1"
                    label="PLG_SYSTEM_MERTOOLS_DARK_A11Y_LABEL" description="PLG_SYSTEM_MERTOOLS_DARK_A11Y_DESC" />
                <field name="dark_mobile_place" type="list" default="same" showon="dark_enabled:1[AND]dark_toggle:1"
                    label="PLG_SYSTEM_MERTOOLS_DARK_MPLACE_LABEL" description="PLG_SYSTEM_MERTOOLS_DARK_MPLACE_DESC">
                    <option value="same">PLG_SYSTEM_MERTOOLS_DARK_MPLACE_SAME</option>
                    <option value="burger">PLG_SYSTEM_MERTOOLS_DARK_MPLACE_BURGER</option>
                    <option value="float">PLG_SYSTEM_MERTOOLS_DARK_PLACE_FLOAT</option>
                    <option value="float-left">PLG_SYSTEM_MERTOOLS_DARK_PLACE_FLOAT_LEFT</option>
                    <option value="float-a11y-above">PLG_SYSTEM_MERTOOLS_DARK_PLACE_A11Y_ABOVE</option>
                    <option value="float-a11y-beside">PLG_SYSTEM_MERTOOLS_DARK_PLACE_A11Y_BESIDE</option>
                    <option value="selector">PLG_SYSTEM_MERTOOLS_DARK_MPLACE_SELECTOR</option>
                    <option value="hidden">PLG_SYSTEM_MERTOOLS_DARK_MPLACE_HIDDEN</option>
                </field>
                <field name="dark_mobile_bp" type="number" default="768" min="320" max="1400" step="1" filter="integer"
                    showon="dark_enabled:1[AND]dark_toggle:1[AND]dark_mobile_place!:same"
                    label="PLG_SYSTEM_MERTOOLS_DARK_MBP_LABEL" description="PLG_SYSTEM_MERTOOLS_DARK_MBP_DESC" />
                <field name="dark_mobile_x" type="number" default="16" min="0" max="400" step="1" filter="integer"
                    showon="dark_enabled:1[AND]dark_toggle:1[AND]dark_mobile_place:float,float-left"
                    label="PLG_SYSTEM_MERTOOLS_DARK_MX_LABEL" description="PLG_SYSTEM_MERTOOLS_DARK_FLOAT_X_DESC" />
                <field name="dark_mobile_y" type="number" default="16" min="0" max="400" step="1" filter="integer"
                    showon="dark_enabled:1[AND]dark_toggle:1[AND]dark_mobile_place:float,float-left"
                    label="PLG_SYSTEM_MERTOOLS_DARK_MY_LABEL" description="PLG_SYSTEM_MERTOOLS_DARK_FLOAT_Y_DESC" />
                <field name="dark_mobile_selector" type="text" default=""
                    showon="dark_enabled:1[AND]dark_toggle:1[AND]dark_mobile_place:selector"
                    label="PLG_SYSTEM_MERTOOLS_DARK_MSEL_LABEL" description="PLG_SYSTEM_MERTOOLS_DARK_MSEL_DESC" />
                <field name="dark_mobile_insert" type="list" default="append"
                    showon="dark_enabled:1[AND]dark_toggle:1[AND]dark_mobile_place:selector"
                    label="PLG_SYSTEM_MERTOOLS_DARK_MINS_LABEL" description="PLG_SYSTEM_MERTOOLS_DARK_MINS_DESC">
                    <option value="append">PLG_SYSTEM_MERTOOLS_DARK_MINS_APPEND</option>
                    <option value="prepend">PLG_SYSTEM_MERTOOLS_DARK_MINS_PREPEND</option>
                    <option value="before">PLG_SYSTEM_MERTOOLS_DARK_MINS_BEFORE</option>
                    <option value="after">PLG_SYSTEM_MERTOOLS_DARK_MINS_AFTER</option>
                </field>
                <field name="dark_toggle_size" type="number" default="44" min="24" max="96" step="1" filter="integer"
                    showon="dark_enabled:1[AND]dark_toggle:1"
                    label="PLG_SYSTEM_MERTOOLS_DARK_SIZE_LABEL" description="PLG_SYSTEM_MERTOOLS_DARK_SIZE_DESC" />
